# ── NeuroSight AI EC2 deployment config ──────────────────────────────
# Copy this file to .env on the EC2 instance and fill in real values.
# NEVER commit the real .env to git.

DOCKER_USER=madhusudhanchilumula
TAG=latest

# Set these to the SAME AWS keys already used by your local backend/.env
# (the backend uses DynamoDB for user accounts and query logs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Change this to a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Grafana admin password (defaults to "admin" if not set — change it!)
GRAFANA_ADMIN_PASSWORD=change-me-too

# Internal URL the backend uses to reach Prometheus (defaults to http://prometheus:9090).
# Only override for local development, e.g. PROMETHEUS_URL=http://localhost:9090
#PROMETHEUS_URL=http://prometheus:9090